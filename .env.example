# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: Required for standalone frontend deployments (like Vercel)
# to communicate with your separately hosted backend server (like Render, Railway, or Heroku).
# If empty, the frontend assumes the API is running on the same domain.
VITE_API_URL=
