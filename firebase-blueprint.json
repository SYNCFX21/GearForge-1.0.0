{
  "entities": {
    "SavedLoadout": {
      "title": "GearForgeDB Saved Loadout",
      "description": "Saved peripheral loadouts and configurations created by users in GearForgeDB",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "budget": { "type": "number" },
        "playstyle": { "type": "string" },
        "createdAt": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "name", "budget", "playstyle", "createdAt"]
    },
    "UserProfile": {
      "title": "GearForgeDB User Profile",
      "description": "User profile and VIP status recorded in GearForgeDB",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isVip": { "type": "boolean" },
        "vipTierName": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "GearForgeDB user profile document"
    },
    "/users/{userId}/loadouts/{loadoutId}": {
      "schema": "SavedLoadout",
      "description": "GearForgeDB user saved loadout documents"
    }
  }
}
