rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is an admin or super_admin
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }
    
    // Helper function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Users can read all profiles, but only write their own (unless admin)
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
      
      match /loadouts/{loadoutId} {
        // Anyone can read loadouts, but only owner/admin can write
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }
    
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
    
    match /{document=**} {
      allow read, write: if false; // Default deny for everything else
    }
  }
}
