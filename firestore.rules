rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is an admin or super_admin
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }
    
    // Helper function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Anyone signed in can read public profiles (email is in subcollection)
      allow read: if isAuthenticated();

      // A user can create their own doc, but privileged fields must start at safe defaults
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['user', 'super_admin', null] &&
        request.resource.data.isVip in [false, null] &&
        request.resource.data.hasPermanentAdFree in [false, null] &&
        request.resource.data.isMuted in [false, null];

      // A user can update their own doc, but MAY NOT change privileged fields themselves
      allow update: if isOwner(userId) &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('isVip', null) == resource.data.get('isVip', null) &&
        request.resource.data.get('hasPermanentAdFree', null) == resource.data.get('hasPermanentAdFree', null) &&
        request.resource.data.get('isMuted', null) == resource.data.get('isMuted', null) &&
        request.resource.data.get('mutedUntil', null) == resource.data.get('mutedUntil', null);

      // Admins can change anything, including privileged fields
      allow update, delete: if isAdmin();
      
      match /private/{doc} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /loadouts/{loadoutId} {
        // Anyone can read loadouts, but only owner/admin can write
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }
    
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false; // Default deny for everything else
    }
  }
}
